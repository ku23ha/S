NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase: app uses the transaction pooler (port 6543); migrations use the
# session pooler (port 5432) or direct connection. Copy hosts from Connect.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: razorpay (INR, UPI, settles to an Indian bank) or dodo (USD, merchant of record)
PAYMENTS_PROVIDER=razorpay
NEXT_PUBLIC_PRICE_CURRENCY=INR   # INR with razorpay; USD (or unset) with dodo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MODE=test            # dodo only: test | live
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STANDARD=
DODO_PRODUCT_POPULAR=
DODO_PRODUCT_ICONIC=
DODO_PRODUCT_PRINT_ADDON=

RESEND_API_KEY=
EMAIL_FROM=

ADMIN_PASSWORD_HASH=          # npm run admin:hash
SESSION_SECRET=               # 32+ random characters
VIEWER_HASH_SALT=             # 32+ random characters, different from SESSION_SECRET

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional affiliate ids for the gift shop links (/gifts). When any is set,
# the shop shows a commission disclosure. Myntra has no query-string id.
NEXT_PUBLIC_AMAZON_TAG_IN=
NEXT_PUBLIC_AMAZON_TAG_COM=
NEXT_PUBLIC_FLIPKART_AFFID=
RESERVATION_MINUTES=15
